# =============================================================================
# Poda AI — configuración (OPCIONAL)
# No hace falta .env para arrancar: ejecuta  poda dashboard  y configura ahí
# LiteLLM, GitHub Copilot o los dos, y el modelo. Lo del dashboard manda sobre .env,
# y la línea de comandos (--provider, --model...) manda sobre todo.
# Si prefieres .env, copia este fichero como .env (no se sube a git).
# =============================================================================

# Proveedor: litellm (opción A) | copilot (opción B). Si no se indica, se usa el
# que esté configurado (LiteLLM si hay API key; si no, Copilot si hay sesión).
# LLM_PROVIDER=litellm

# -----------------------------------------------------------------------------
# Opción A · Gateway LiteLLM corporativo
# La URL y la API key son obligatorias para usar LiteLLM.
# -----------------------------------------------------------------------------
LITELLM_API_KEY=
# URL del gateway (obligatoria)
LITELLM_BASE_URL=
# Alias del modelo en el gateway (opcional: mejor elígelo en el dashboard)
# LITELLM_MODEL=
# Modelo más barato para el triaje en modo snippet (opcional)
# LITELLM_SMALL_MODEL=

# -----------------------------------------------------------------------------
# Opción B · GitHub Copilot con el proxy local
# Conéctalo en el dashboard («Conectar con GitHub») o con  poda login copilot.
# La sesión se guarda en .copilot/ (fuera de git).
# -----------------------------------------------------------------------------
# COPILOT_MODEL=
# COPILOT_SMALL_MODEL=
# Puerto del proxy local (solo escucha en 127.0.0.1; por defecto 4142)
# COPILOT_PROXY_PORT=4142
# Opcionales: COPILOT_ENDPOINT=auto|chat|responses|messages, COPILOT_REASONING_EFFORT=low|medium|high

# -----------------------------------------------------------------------------
# Poda AI
# -----------------------------------------------------------------------------
# Idioma del informe y de los motivos que redacta la IA
OUTPUT_LANGUAGE=Spanish
# Modelo de triaje (por defecto, el mismo modelo principal)
# PODA_TRIAGE_MODEL=
# Directorios que no se analizan (se copian tal cual), separados por coma
# EXCLUDE_DIRS=
# Llamadas al modelo en paralelo (--jobs)
# PODA_JOBS=2
# Tarifas para estimar el coste si el proveedor no lo da (USD por millón de tokens)
# PODA_PRICE_INPUT_PER_MTOK=
# PODA_PRICE_OUTPUT_PER_MTOK=
# Carpeta de aplicaciones legacy que docker compose monta en target/ (el original no se toca).
# TARGET_DIR=./target
# Carpeta que docker compose monta en output/: ahí queda output/<aplicación> con la copia limpia,
# el informe y las métricas.
# OUTPUT_DIR=./output

# -----------------------------------------------------------------------------
# SonarQube de Poda AI (lo levanta docker compose y Poda AI lo prepara solo)
# Puerto de su interfaz web en este equipo (por defecto 9001) y contraseña de su
# base de datos (solo la ve SonarQube, dentro de la red de Poda AI).
# PODA_SONAR_PORT=9001
# PODA_SONAR_DB_PASSWORD=
# Solo si Poda AI no puede prepararlo solo (la contraseña de admin ya no es la inicial):
# token creado a mano en SonarQube (My Account → Security).
# SONAR_TOKEN=
